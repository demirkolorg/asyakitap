# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env or real credentials.

# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Supabase project URL and publishable/anon key for browser and server auth.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
